---
import Layout from './Layout.astro';
import AlertBanner from '../components/AlertBanner.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  tags: string[];
}

const { title, tags } = Astro.props;

function slugify(tag: string): string {
  return tag
    .normalize('NFD')
    .replace(/[\u0300-\u036f]/g, '')
    .toLowerCase()
    .trim()
    .replace(/[^a-z0-9\s-]/g, '')
    .replace(/\s+/g, '-');
}
---

<Layout title={title}>
  <AlertBanner />
  <main
    style="flex:1; padding: 48px; max-width: 760px; margin: 0 auto; width: 100%;"
  >
    <a
      href="/"
      style="font-family:'Oswald',sans-serif; font-size:0.85rem; letter-spacing:0.08em;
      text-transform:uppercase; color:var(--olive-leaf); text-decoration:none; 
      display:inline-block; margin-bottom:32px;"
    >
      ← Voltar
    </a>

    <div class="modal-tags">
      {
        tags.map((t) => (
          <span class="tag" data-slug={slugify(t)}>
            {t}
          </span>
        ))
      }
    </div>

    <h2 id="modal-titulo" style="margin-top:12px;">{title}</h2>

    <article id="modal-letra">
      <slot />
    </article>
  </main>
  <Footer />
</Layout>
