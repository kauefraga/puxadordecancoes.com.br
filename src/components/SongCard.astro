---
interface Props {
  id: number;
  title: string;
  tags: string[];
  slug: string;
  lyricsPreview: string;
  hasMore: boolean;
}

const { id, title, tags, slug, lyricsPreview, hasMore } = Astro.props;

function slugify(tag: string): string {
  return tag
    .normalize('NFD')
    .replace(/[\u0300-\u036f]/g, '')
    .toLowerCase()
    .trim()
    .replace(/[^a-z0-9\s-]/g, '')
    .replace(/\s+/g, '-');
}
---

<article
  class="cancao-card"
  data-title={title.toLowerCase()}
  data-tags={tags.join(',').toLowerCase()}
  style="height: 100%;"
>
  <div class="card-numero">{String(id).padStart(2, '0')}</div>
  <div class="card-body">
    <h3 class="card-titulo">{title}</h3>
    <div class="card-tags">
      {
        tags.map((t) => (
          <span class="tag" data-slug={slugify(t)}>
            {t}
          </span>
        ))
      }
    </div>
    <p class="card-preview">
      {lyricsPreview}
      {hasMore ? '\n' : ''}
      {hasMore && <span class="reticencias">...</span>}
    </p>
  </div>
  <a
    href={`/cancoes/${slug}`}
    class="card-btn-ver"
    aria-label={`Ver letra completa de ${title}`}
  >
    VER LETRA
  </a>
</article>
